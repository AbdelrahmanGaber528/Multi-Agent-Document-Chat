# OpenAI-compatible provider (OpenRouter example)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=replace_with_your_api_key
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

WHISPER_MODEL=base.en
MAX_AUDIO_UPLOAD_MB=10

# Local image OCR model cache (persists in Docker through ./data)
OCR_MODEL_DIR=data/rapidocr_models

# Local embeddings and Chroma
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DB_BACKEND=chroma
VECTOR_COLLECTION=documents

# Retrieval / orchestration
TOP_K_SEMANTIC=20
TOP_K_KEYWORD=20
TOP_K_RERANKED=10
FINAL_CONTEXT_CHUNKS=8
CONTEXT_TOKEN_BUDGET=6000
MAX_ROUNDS=3
